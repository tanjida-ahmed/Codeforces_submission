#include<stdio.h>
int main()
{
	long long num;
	scanf("%lld",&num);

	int t;
	scanf("%d",&t);

	int remainder;

	while(t--)
	{
       remainder=num%10;
       if(remainder%10!=0)
       {
       	num=num-1;
       }
       else if(remainder%10==0)
       {
       	num=num/10;
       }
	}
	printf("%d",num);
}
